            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT max(psi / psi_limit) AS \"PSI / порог\"\nFROM feature_drift\nWHERE model_version = (SELECT model_version FROM forecasts ORDER BY as_of DESC, created_at DESC LIMIT 1)\n  AND as_of = (SELECT max(as_of) FROM feature_drift WHERE model_version = (SELECT model_version FROM forecasts ORDER BY as_of DESC, created_at DESC LIMIT 1))"
