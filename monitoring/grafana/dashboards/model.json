    {
      "id": 2,
      "type": "stat",
      "title": "Качество за 20 дней",
      "description": "rmse_to_naive версии в работе за последние 20 дней с известным фактом. Меньше 1 — модель точнее наивного прогноза «завтра как сегодня». Выше 1 — проверка evaluate-forecasts падает.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
