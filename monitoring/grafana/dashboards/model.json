            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT rmse_to_naive_20d AS \"rmse_to_naive за 20 дней\"\nFROM forecast_quality\nWHERE model_version = (SELECT model_version FROM forecasts ORDER BY as_of DESC, created_at DESC LIMIT 1)\n  AND rmse_to_naive_20d IS NOT NULL\nORDER BY as_of DESC\nLIMIT 1"
        }
      ],
