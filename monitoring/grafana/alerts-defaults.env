# alerts-defaults.env — заглушки настроек оповещений для Grafana (этап 6).
#
# Grafana не запускается совсем — ни дашборды, ни оповещения, — если в
# настройке контакта Telegram пустой токен: «could not find Bot Token in
# settings». Чтобы Grafana работала и тогда, когда файла .env.alerts ещё нет
# (свежий клон, бот ещё не создан), compose.yaml сначала читает этот файл, а
# потом .env.alerts: значения из .env.alerts заменяют заглушки.
# С заглушками Grafana работает, правила считаются, но сообщения не уходят:
# такого бота нет, и Telegram отвечает ошибкой (она видна в логе Grafana).
TELEGRAM_BOT_TOKEN=not-configured
TELEGRAM_CHAT_ID=0
