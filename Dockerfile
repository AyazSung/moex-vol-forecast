# Dockerfile — рецепт образа проекта. В одном образе все команды проекта:
# загрузчик (fetch-candles, import-candles), обучение и прогноз (train-model,
# predict-vol), API (uvicorn) и сервер MLflow. Какую запустить, решает
# docker compose (command: у каждого сервиса) или аргумент после имени образа.
# Образ собирает CI (GitHub Actions, этап 5) и публикует как ghcr.io/ayazsung/moex-vol.
# Собрать у себя для проверки:  docker build -t moex-vol:dev .
# Запуск:  docker run --rm -v "$(pwd)/data:/app/data" --env-file .env ghcr.io/ayazsung/moex-vol:0.6.1
#
# Образ собирается в две стадии:
#   1) builder («мастерская») — ставим библиотеки и наш код в окружение .venv;
#   2) итоговый образ — забираем из мастерской только готовый .venv.
# Инструменты сборки (uv, исходники) в итоговый образ не попадают: он меньше и чище.
#
# В Dockerfile комментарии пишутся только отдельными строками: «#» в конце строки
# с инструкцией Docker воспринял бы как часть команды.

# ---------- stage 1: build ----------
# Основа — облегчённый Debian с Python 3.13 (та же версия, что локально).
# AS builder — имя стадии: по нему ниже заберём из неё результат.
FROM python:3.13-slim AS builder

# Берём программу uv из официального образа uv той же версии, что стоит локально.
# uv нужен только здесь, в мастерской, чтобы поставить библиотеки.
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/

# Запрещаем uv скачивать свой Python. Окружение .venv ссылается на Python
# основного образа (/usr/local/bin/python3), а он есть и в итоговой стадии.
# Свой Python от uv остался бы в мастерской, и в итоговом образе .venv не запустился бы.
ENV UV_PYTHON_DOWNLOADS=never

# Рабочая папка внутри образа: все следующие команды выполняются в /app.
WORKDIR /app

# Сначала копируем только описание зависимостей и ставим библиотеки.
# Этот шаг кэшируется: пока pyproject.toml и uv.lock не менялись, при пересборке
# pandas и остальное заново не скачиваются (правка кода не затрагивает этот шаг).
#   --locked             — ставить строго по uv.lock; если он устарел, сборка падает;
#   --no-dev             — без ruff и pytest: они нужны только разработчику;
#   --no-install-project — наш код ещё не скопирован, ставим только библиотеки.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

# Теперь наш код. README.md нужен uv, чтобы собрать пакет (он указан в pyproject.toml).
#   --no-editable — копируем код пакета внутрь .venv: тогда .venv самодостаточен,
#                   и в итоговый образ достаточно перенести только его.
COPY README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

# ---------- stage 2: runtime ----------
# Итоговый образ начинается заново с той же основы: Python лежит там же,
# куда ведёт ярлык .venv/bin/python. Из мастерской сюда ничего не попадает само.
FROM python:3.13-slim

# Создаём обычного пользователя app (номер uid 1000) вместо администратора root:
# если в библиотеке найдут уязвимость, у программы не будет прав менять систему.
# Сразу создаём папки для данных и для файлов моделей сервера MLflow и делаем app
# их владельцем — иначе он не смог бы в них писать. Именованный том, подключённый
# к такой папке, при первом запуске получает того же владельца.
#   && — следующая команда выполняется, только если предыдущая прошла успешно;
#   \  — команда продолжается на следующей строке.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/data /app/mlartifacts \
    && chown app:app /app/data /app/mlartifacts

WORKDIR /app

# Забираем из мастерской только готовое окружение. --chown: владелец файлов — app.
COPY --from=builder --chown=app:app /app/.venv /app/.venv

# PATH     — «активируем» .venv: команды fetch-candles, uvicorn, mlflow и другие
#            лежат в /app/.venv/bin.
# DATA_DIR — куда загрузчик пишет данные (см. config.py). Чтобы данные сохранились
#            на компьютере, при запуске подключай сюда папку:
#            -v "$(pwd)/data:/app/data".
# PYTHONUNBUFFERED=1 — print() выводится сразу, а не копится в буфере до конца
#            программы: без этого в логах контейнера таблица прогноза оказалась бы
#            после строк лога, напечатанных позже неё.
ENV PATH="/app/.venv/bin:$PATH" \
    DATA_DIR=/app/data \
    PYTHONUNBUFFERED=1

# Всё дальше, включая сам загрузчик, работает от имени app, а не root.
USER app

# Команда по умолчанию при старте контейнера. Форма списком ["..."]: программа
# становится PID 1 и сама получает SIGTERM от docker stop (обработчик есть в cli.py).
# Сервисы в compose.yaml заменяют её своей (command:).
CMD ["fetch-candles"]
