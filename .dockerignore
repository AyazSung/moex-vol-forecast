# .dockerignore — что НЕ отправлять в сборку образа (как .gitignore, только для Docker).
# При `docker build .` всё содержимое папки проекта отправляется сборщику,
# а строки ниже исключают лишнее и опасное. Комментарии — только отдельными строками.

# Окружение и кэш: в образе они свои. .venv собран под macOS
# и внутри Linux-контейнера бесполезен.
.venv/
__pycache__/
.ruff_cache/
.pytest_cache/

# Секреты никогда не кладём в образ: образ могут скачать другие люди и прочитать всё,
# что в нём лежит. Настройки передаются при запуске: docker run --env-file .env ...
.env

# Данные, логи, история Git, настройки редактора — загрузчику в образе не нужны.
data/
logs/
.git/
.vscode/

# Журнал и файлы моделей MLflow с Mac: в образе им не место — модели контейнеры
# берут у сервера MLflow.
mlflow.db
mlruns/
mlartifacts/
