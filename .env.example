# .env.example — шаблон настроек загрузчика. Лежит в Git, секретов в нём нет.
# Как пользоваться: cp .env.example .env, затем вписать свои значения в .env
# (.env в Git не попадает — он в .gitignore).
# Запуск с настройками:  uv run --env-file .env fetch-candles
#                   или  docker compose run --rm loader   (compose читает .env сам)
# Комментарии — только отдельными строками: «#» в конце строки стал бы частью значения.

# Тикер акции на Московской бирже: SBER, GAZP, LKOH и т.д.
TICKER=SBER

# С какой даты скачивать дневные свечи, формат ГГГГ-ММ-ДД.
FROM_DATE=2026-10-01

# Необязательные настройки (раскомментируй, чтобы задать):
# папка для данных — по умолчанию data в проекте; в Docker уже задана как /app/data
# DATA_DIR=/path/to/data
# подробность логов: DEBUG, INFO, WARNING, ERROR — по умолчанию INFO
# LOG_LEVEL=INFO

# адрес базы PostgreSQL: если задан, свечи пишутся ещё и в базу.
# Для запуска на Mac с базой из docker compose (в compose он задан сам):
# DATABASE_URL=postgresql://moex:moex@localhost:5432/moex

# адрес журнала и реестра MLflow. Без него — файл mlflow.db в корне проекта (этап 2).
# С сервером MLflow из docker compose (в compose для контейнеров он задан сам):
# MLFLOW_TRACKING_URI=http://localhost:5001
